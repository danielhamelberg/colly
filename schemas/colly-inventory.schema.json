{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colly.local/schemas/colly-inventory.schema.json",
  "title": "Colly canonical inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "requestSha256", "bundle", "limits", "files", "excluded"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "root": {"type": "string", "minLength": 1},
    "requestSha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64},
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles", "maxSourceBytes", "maxBundleBytes", "maxScanEntries", "deadlineSeconds"],
      "properties": {
        "maxFiles": {"type": "integer", "minimum": 1},
        "maxSourceBytes": {"type": "integer", "minimum": 1},
        "maxBundleBytes": {"type": "integer", "minimum": 1},
        "maxScanEntries": {"type": "integer", "minimum": 1},
        "deadlineSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relativePath",
          "sourceSizeBytes",
          "sourceSha256",
          "renderedSizeBytes",
          "renderedSha256",
          "encoding",
          "language",
          "selectionReasons",
          "contentMode",
          "transformations"
        ],
        "properties": {
          "relativePath": {"type": "string"},
          "sourceSizeBytes": {"type": "integer", "minimum": 0},
          "sourceSha256": {"type": "string", "minLength": 64, "maxLength": 64},
          "renderedSizeBytes": {"type": "integer", "minimum": 0},
          "renderedSha256": {"type": "string", "minLength": 64, "maxLength": 64},
          "encoding": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "selectionReasons": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["explicit-file", "glob-match", "directory-scan", "dependency-expansion"]}
          },
          "contentMode": {"type": "string", "enum": ["verbatim", "transformed"]},
          "transformations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "parameters", "beforeSha256", "afterSha256"],
              "properties": {
                "kind": {"type": "string", "enum": ["auto-truncate"]},
                "parameters": {"type": "object"},
                "beforeSha256": {"type": "string", "minLength": 64, "maxLength": 64},
                "afterSha256": {"type": "string", "minLength": 64, "maxLength": 64}
              }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "reason", "requested"],
        "properties": {
          "relativePath": {"type": "string"},
          "reason": {"type": "string"},
          "requested": {"type": "boolean"}
        }
      }
    }
  }
}
